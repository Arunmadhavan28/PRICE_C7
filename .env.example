# ==============================================================================
# RETAIL AI VIBE-CODING CHALLENGE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Then fill in your keys below.
#
# NOTE: The apps in this repo are designed to run 100% locally out-of-the-box.
# Teams using LLM features (e.g. Team 2 Sassy Stylist, Team 5 Empathy Engine)
# can plug in the Google Gemini API key below.
# ==============================================================================

# Google Gemini API Key (100% FREE — No Credit Card Required)
# 1. Visit: https://aistudio.google.com/
# 2. Sign in with your Google account.
# 3. Click "Get API key" -> "Create API key".
# 4. Paste your key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model Selection (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Port configuration if running apps simultaneously
STREAMLIT_SERVER_PORT=8501
